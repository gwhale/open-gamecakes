# Copy to .env.local and fill in. .env.local is gitignored.
#
# Only the four values under REQUIRED are needed to run. Everything else
# switches on an optional feature and can be left empty.

# ============================================================
# REQUIRED — Supabase
# ============================================================
# All three are on your project dashboard under Project Settings -> API.
# URL is https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Publishable key — safe to expose to the browser. Prefixed sb_publishable_...
# Row-level security is what protects the data, not the secrecy of this key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Secret key — SERVER ONLY. Bypasses every row-level security policy.
# Never commit it, never send it to a browser. Prefixed sb_secret_...
SUPABASE_SECRET_KEY=sb_secret_your-key

# Spike-only Needle renderer. Leave 0 unless you are working on it.
NEXT_PUBLIC_ENABLE_NEEDLE_TOWN=0


# ============================================================
# There is NO site password, and no email in the login flow
# ============================================================
# Accounts are Supabase Auth users. At signup a parent picks a family login
# slug (e.g. "shackleton") and a password; the slug is mapped to a synthetic
# address <slug>@gamecakes.family which is created with email_confirm: true.
# That domain is unregistered and never receives mail, so there is no
# confirmation step and no magic link to wait for.
#
# Signup needs an invite code — run `node scripts/setup.mjs` to mint one.
#
# Kids are gated separately by a per-kid PIN stored in kids.pin, set from the
# parent dashboard. That is a database value, not an environment variable.


# ============================================================
# OPTIONAL — everything below switches on one feature
# ============================================================

# Parent observation photos: upload a picture of homework and a vision model
# pre-fills the observation form. Without it, photo extraction is unavailable
# and the rest of the dashboard is unaffected. Key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Weekly family digest email, sent by the cron route.
# All three are needed together; without them no digest is sent.
RESEND_API_KEY=
DIGEST_FROM=
NEXT_PUBLIC_SITE_URL=https://your-deployment.example.com

# Shared secret the weekly-digest cron endpoint requires, so the route cannot
# be triggered by anyone who finds the URL. Any long random string.
CRON_SECRET=

# Signs the public Supabase Realtime channel name for town presence, so the
# raw family_id is never used as a channel anyone could guess or join.
# Any long random string. Rotating it disconnects current sessions.
REALTIME_TOPIC_SECRET=

# Password for the standalone /ba arcade, which has no login and saves no
# progress. Has a working default, so set this only if you use that page.
BA_PASSWORD=


# ============================================================
# Not used by the app — build-time tooling only
# ============================================================
# Cakey's voice lines ship pre-rendered as mp3s under public/voice and are
# served as static files, so running Gamecakes never calls a text-to-speech
# API and costs nothing. A key is needed only to regenerate or add lines,
# and it must be your own:
#   ELEVENLABS_API_KEY=... node --experimental-strip-types \
#     --import ./scripts/ts-resolve.mjs scripts/render-cakey-voice.mjs
ELEVENLABS_API_KEY=

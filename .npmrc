# Required by the Needle Engine spike, and only by it.
#
# The root `three` is aliased to npm:@needle-tools/three@0.185.2-alpha.1, whose
# real package version is a PRERELEASE. npm's semver ranges exclude prereleases
# unless the range itself names one, so an ordinary peer range like maath's
# `three@">=0.134.0"` does not match it and a cold `npm install` dies with:
#
#   npm error code ERESOLVE
#   Could not resolve dependency: peer three@">=0.134.0" from maath@0.10.8
#
# This does not reproduce against a warm node_modules, so it only surfaced on a
# clean CI/Vercel install — it failed the very first preview deploy of PR #259.
#
# legacy-peer-deps (npm v6 behaviour: don't auto-install or enforce peers) is
# preferred over --force, which would also let npm write genuinely broken trees.
#
# REMOVE THIS FILE if `three` ever goes back to a normal published version.
# Until then it applies repo-wide, so a real future peer conflict will be
# silenced too — worth re-checking whenever a 3D dependency is added.
legacy-peer-deps=true
